<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Tracking Order"
            android:textColor="@color/md_theme_Text2"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/timelineCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/md_theme_itemPop"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/tvHeader">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/tvInvoice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Invoice : #256891"
                    android:textColor="@color/md_theme_Text2"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="16dp"
                    android:background="#EAEAEA"
                    app:layout_constraintTop_toBottomOf="@id/tvInvoice" />

                <ImageView
                    android:id="@+id/iconStep1"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_circle_stroke_green"
                    android:padding="8dp"
                    android:src="@drawable/order_approve_24px"
                    app:tint="@color/md_theme_Text2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider" />

                <TextView
                    android:id="@+id/tvStep1Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Order Received"
                    android:textColor="@color/md_theme_Text2"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/tvStep1Sub"
                    app:layout_constraintStart_toEndOf="@id/iconStep1"
                    app:layout_constraintTop_toTopOf="@id/iconStep1"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/tvStep1Sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="🕒 10:52 AM, 23 May 2022"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@id/iconStep1"
                    app:layout_constraintStart_toStartOf="@id/tvStep1Title"
                    app:layout_constraintTop_toBottomOf="@id/tvStep1Title" />

                <ImageView
                    android:id="@+id/iconStep2"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="40dp"
                    android:background="@drawable/bg_circle_stroke_green"
                    android:padding="8dp"
                    android:src="@drawable/microwave_24px"
                    app:tint="@color/md_theme_Text2"
                    app:layout_constraintEnd_toEndOf="@id/iconStep1"
                    app:layout_constraintStart_toStartOf="@id/iconStep1"
                    app:layout_constraintTop_toBottomOf="@id/iconStep1" />

                <View
                    android:id="@+id/line1"
                    android:layout_width="4dp"
                    android:layout_height="0dp"
                    android:layout_marginVertical="4dp"
                    android:background="@drawable/bg_dashed_line2"
                    android:layerType="software"
                    app:layout_constraintBottom_toTopOf="@id/iconStep2"
                    app:layout_constraintEnd_toEndOf="@id/iconStep1"
                    app:layout_constraintStart_toStartOf="@id/iconStep1"
                    app:layout_constraintTop_toBottomOf="@id/iconStep1" />

                <TextView
                    android:id="@+id/tvStep2Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Preparing your food"
                    android:textColor="@color/md_theme_Text2"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/tvStep2Sub"
                    app:layout_constraintStart_toEndOf="@id/iconStep2"
                    app:layout_constraintTop_toTopOf="@id/iconStep2"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/tvStep2Sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="🕒 Our chef is cooking your meal"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@id/iconStep2"
                    app:layout_constraintStart_toStartOf="@id/tvStep2Title"
                    app:layout_constraintTop_toBottomOf="@id/tvStep2Title" />

                <ImageView
                    android:id="@+id/iconStep3"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="40dp"
                    android:background="@drawable/bg_circle_stroke_green"
                    android:padding="8dp"
                    android:src="@drawable/task_alt_24px"
                    app:tint="@color/md_theme_Text2"
                    app:layout_constraintEnd_toEndOf="@id/iconStep2"
                    app:layout_constraintStart_toStartOf="@id/iconStep2"
                    app:layout_constraintTop_toBottomOf="@id/iconStep2" />

                <View
                    android:id="@+id/line2"
                    android:layout_width="4dp"
                    android:layout_height="0dp"
                    android:layout_marginVertical="4dp"
                    android:background="@drawable/bg_dashed_line2"
                    android:layerType="software"
                    app:layout_constraintBottom_toTopOf="@id/iconStep3"
                    app:layout_constraintEnd_toEndOf="@id/iconStep2"
                    app:layout_constraintStart_toStartOf="@id/iconStep2"
                    app:layout_constraintTop_toBottomOf="@id/iconStep2" />

                <TextView
                    android:id="@+id/tvStep3Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Order Ready"
                    android:textColor="@color/md_theme_Text2"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/tvStep3Sub"
                    app:layout_constraintStart_toEndOf="@id/iconStep3"
                    app:layout_constraintTop_toTopOf="@id/iconStep3"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/tvStep3Sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="🕒 Waiting for the delivery"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@id/iconStep3"
                    app:layout_constraintStart_toStartOf="@id/tvStep3Title"
                    app:layout_constraintTop_toBottomOf="@id/tvStep3Title" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvEstimatedTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Estimated Arrival"
            android:textColor="#777777"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/timelineCard" />

        <TextView
            android:id="@+id/tvETA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00 min"
            android:textColor="#4A9E86"
            android:textSize="52sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvEstimatedTitle" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/driverCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/md_theme_itemPop"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/tvETA">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgDriver"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:scaleType="centerCrop"
                    tools:src="@tools:sample/avatars"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent" />

                <TextView
                    android:id="@+id/tvDriverName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    android:text="Food CAF"
                    android:textColor="@color/md_theme_Text2"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@+id/tvDriverRole"
                    app:layout_constraintEnd_toStartOf="@id/btncall"
                    app:layout_constraintStart_toEndOf="@id/imgDriver"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/tvDriverRole"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="+94 77 330 6912"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/imgDriver"
                    app:layout_constraintTop_toBottomOf="@id/tvDriverName" />

                <ImageView
                    android:id="@+id/btnMessage"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_stroke_green"
                    android:padding="10dp"
                    android:src="@android:drawable/ic_dialog_email"
                    app:tint="#4A9E86"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/btncall"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_circle_stroke_green"
                    android:padding="10dp"
                    android:src="@android:drawable/ic_menu_call"
                    app:tint="#4A9E86"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnMessage"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMyOrder"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="#4A9E86"
            android:text="My Order"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:layout_constraintTop_toBottomOf="@id/driverCard" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>