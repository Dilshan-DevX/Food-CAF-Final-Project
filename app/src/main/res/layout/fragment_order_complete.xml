<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Tracking Order"
            android:textColor="#222222"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/timelineBackground"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintBottom_toBottomOf="@id/tvStep3Sub"
            app:layout_constraintTop_toBottomOf="@id/tvHeader" />

        <TextView
            android:id="@+id/tvInvoice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Invoice : #256891"
            android:textColor="#222222"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/timelineBackground"
            app:layout_constraintStart_toStartOf="@id/timelineBackground"
            app:layout_constraintTop_toTopOf="@id/timelineBackground" />

        <ImageView
            android:id="@+id/iconStep1"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_circle_stroke_green"
            android:padding="8dp"
            android:src="@drawable/order_approve_24px"
            app:tint="@color/md_theme_Text2"
            app:layout_constraintStart_toStartOf="@id/timelineBackground"
            app:layout_constraintTop_toBottomOf="@id/tvInvoice" />

        <TextView
            android:id="@+id/tvStep1Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Order Received"
            android:textColor="#222222"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/tvStep1Sub"
            app:layout_constraintStart_toEndOf="@id/iconStep1"
            app:layout_constraintTop_toTopOf="@id/iconStep1"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tvStep1Sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🕒 10: 52 AM, 23 May 2022"
            android:textColor="#777777"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/iconStep1"
            app:layout_constraintStart_toStartOf="@id/tvStep1Title"
            app:layout_constraintTop_toBottomOf="@id/tvStep1Title" />

        <View
            android:id="@+id/line1"
            android:layout_width="2dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_dashed_line"
            android:layerType="software"
            app:layout_constraintEnd_toEndOf="@id/iconStep1"
            app:layout_constraintStart_toStartOf="@id/iconStep1"
            app:layout_constraintTop_toBottomOf="@id/iconStep1" />

        <ImageView
            android:id="@+id/iconStep2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_stroke_green"
            android:padding="8dp"
            android:src="@drawable/microwave_24px"
            app:tint="@color/md_theme_Text2"
            app:layout_constraintEnd_toEndOf="@id/iconStep1"
            app:layout_constraintStart_toStartOf="@id/iconStep1"
            app:layout_constraintTop_toBottomOf="@id/line1" />

        <TextView
            android:id="@+id/tvStep2Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="On the way"
            android:textColor="#222222"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/tvStep2Sub"
            app:layout_constraintStart_toEndOf="@id/iconStep2"
            app:layout_constraintTop_toTopOf="@id/iconStep2"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tvStep2Sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🕒 10: 52 AM"
            android:textColor="#777777"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/iconStep2"
            app:layout_constraintStart_toStartOf="@id/tvStep2Title"
            app:layout_constraintTop_toBottomOf="@id/tvStep2Title" />

        <View
            android:id="@+id/line2"
            android:layout_width="2dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_dashed_line"
            android:layerType="software"
            app:layout_constraintEnd_toEndOf="@id/iconStep2"
            app:layout_constraintStart_toStartOf="@id/iconStep2"
            app:layout_constraintTop_toBottomOf="@id/iconStep2" />

        <ImageView
            android:id="@+id/iconStep3"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_solid_green"
            android:padding="8dp"
            android:src="@drawable/task_alt_24px"
            app:tint="@color/md_theme_Text2"
            app:layout_constraintEnd_toEndOf="@id/iconStep2"
            app:layout_constraintStart_toStartOf="@id/iconStep2"
            app:layout_constraintTop_toBottomOf="@id/line2" />

        <TextView
            android:id="@+id/tvStep3Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Delivered"
            android:textColor="#222222"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/tvStep3Sub"
            app:layout_constraintStart_toEndOf="@id/iconStep3"
            app:layout_constraintTop_toTopOf="@id/iconStep3"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tvStep3Sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🕒 Finish time in 3 min"
            android:textColor="#777777"
            android:textSize="12sp"
            android:paddingBottom="24dp"
            app:layout_constraintBottom_toBottomOf="@id/iconStep3"
            app:layout_constraintStart_toStartOf="@id/tvStep3Title"
            app:layout_constraintTop_toBottomOf="@id/tvStep3Title" />

        <TextView
            android:id="@+id/tvEstimatedTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="estimated arrival"
            android:textColor="#444444"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/timelineBackground" />

        <TextView
            android:id="@+id/tvETA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="25 min"
            android:textColor="#4A9E86"
            android:textSize="48sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvEstimatedTitle" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/driverLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/tvETA">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgDriver"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="centerCrop"
                tools:src="@tools:sample/avatars"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent" />

            <TextView
                android:id="@+id/tvDriverName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:text="Jonathon smith"
                android:textColor="#222222"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnCall"
                app:layout_constraintStart_toEndOf="@id/imgDriver"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/btnCall"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnMessage"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/btncall"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_stroke_green"
                    android:padding="10dp"
                    android:src="@android:drawable/ic_menu_call"
                    app:tint="#4A9E86"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


            </LinearLayout>

            <ImageView
                android:id="@+id/btnMessage"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_stroke_green"
                android:padding="10dp"
                android:src="@android:drawable/ic_dialog_email"
                app:tint="#4A9E86"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMyOrder"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="40dp"
            android:backgroundTint="#4A9E86"
            android:text="My Order"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:layout_constraintTop_toBottomOf="@id/driverLayout" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>